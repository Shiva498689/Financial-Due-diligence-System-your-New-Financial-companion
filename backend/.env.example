# Financial Due Diligence System - Environment Configuration

# Gemini API Key (required for LLM quantitative and narrative generation)
GEMINI_API_KEY=your_gemini_api_key_here

# FRED (Federal Reserve Economic Data) API Key
FRED_API_KEY=your_fred_api_key_here

# Alpaca Market Data API Credentials (for news retrieval)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Groq API Key (for fast LLM peer analysis)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (for web search peer retrieval)
TAVILY_API_KEY=your_tavily_api_key_here

# Qdrant Vector Database
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# SEC EDGAR Identity (User-Agent header required by SEC EDGAR API)
EDGAR_IDENTITY=FinancialDueDiligence System contact@financialdd.com
